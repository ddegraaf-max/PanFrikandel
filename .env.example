# ============================================================
#  PanFrikandel — omgevingsvariabelen
#  Lokaal: kopieer naar .env (wordt automatisch geladen, staat in .gitignore).
#  Railway: zet dezelfde variabelen onder Variables.
#  Leeg laten = standaardwaarde (staat achter elke variabele).
# ============================================================

# ---------- Basis ----------
BASE_URL=https://panfrikandel.pl            # publieke URL van de site (voor links in mails en Stripe-redirects)
PORT=3000                                    # poort (Railway vult dit zelf)

# ---------- Betalingen (Stripe) ----------
STRIPE_SECRET_KEY=sk_test_...                # sk_test_... om te testen, sk_live_... voor echt (Stripe → Developers → API keys)

# ---------- E-mail (Resend) ----------
RESEND_API_KEY=re_...                        # Resend → API Keys (domein panfrikandel.pl eerst verifiëren)
ORDER_EMAIL_FROM=PanFrikandel <zamowienia@panfrikandel.pl>   # afzender van alle mails
ORDER_EMAIL_BCC=                             # jouw adres: kopie van elke bestelling (optioneel)
QUOTE_EMAIL_TO=                              # waar hurt-offertes en food-truck-aanvragen heen gaan (standaard = ORDER_EMAIL_BCC)

# ---------- Bedrijfsgegevens (regulamin, privacybeleid, footer) ----------
COMPANY_NAME=Budomatch Daniel de Graaf      # naam zoals in CEIDG
COMPANY_ADDRESS=                             # bv. "ul. Przykładowa 1, 09-400 Płock"
COMPANY_NIP=                                 # NIP (10 cijfers)
COMPANY_REGON=                               # REGON (optioneel)
COMPANY_EMAIL=hallo@panfrikandel.pl          # contactadres in regulamin/privacy
COMPANY_PHONE=                               # telefoon (optioneel)

# ---------- Admin ----------
ADMIN_PASSWORD=                              # wachtwoord voor /admin (verplicht om admin te gebruiken)

# ---------- Database (Railway PostgreSQL) ----------
DATABASE_URL=                                # Railway → PostgreSQL → DATABASE_URL; zonder database: JSON-bestanden in data/ (niet voor productie)

# ---------- AI-assistent (Anthropic) ----------
ANTHROPIC_API_KEY=sk-ant-...                 # console.anthropic.com; leeg = assistent geeft nette foutmelding

# ---------- Bezorging ----------
DELIVERY_RADIUS_KM=50                        # straal van de bezorgzone rond Płock in km

# ---------- Prijsmodel shop (inkoop Vomar → verkoop) ----------
PRICING_EUR_PLN=4.35                         # koers EUR → PLN
PRICING_MARKUP=2.2                           # opslag op de inkoopprijs (transport, vries, bezorging, btw, marge)

# ---------- Socials ----------
SOCIAL_INSTAGRAM=https://www.instagram.com/panfrikandel
SOCIAL_FACEBOOK=https://www.facebook.com/panfrikandel
SOCIAL_TIKTOK=https://www.tiktok.com/@panfrikandel

# ---------- Food truck ----------
FOODTRUCK_LAUNCH_PL=                         # starttekst, bv. "wiosna 2027" (leeg = "wkrótce")
FOODTRUCK_LAUNCH_EN=                         # bv. "spring 2027" (leeg = "soon")
GPS_TOKEN=                                   # geheim voor de chauffeurspagina /kierowca en POST /api/gps — kies een lange willekeurige string
GPS_STALE_MIN=30                             # na zoveel minuten zonder GPS-signaal is de kar "niet live"

# ---------- Powiadomienia (abonnees) + kortingscode ----------
SUB_SECRET=                                  # geheim voor bevestig-/afmeldlinks in mails (standaard = ADMIN_PASSWORD; kies bij voorkeur een eigen lange string)
SUB_DISCOUNT_PERCENT=10                      # korting (%) voor aangemelde klanten — code PF-XXXXXX
SUB_DISCOUNT_ONCE=true                       # true = code één keer geldig (welkomstkorting), false = onbeperkt
