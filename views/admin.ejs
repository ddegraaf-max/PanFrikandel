<!DOCTYPE html>
<html lang="nl">
<head>
  <title>Admin — PanFrikandel</title>
  <%- include('partials/head') %>
  <meta name="robots" content="noindex,nofollow">
  <% if (authed) { %><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"><% } %>
</head>
<body>
<header class="nav">
  <a href="/" class="logo">
    <svg viewBox="0 0 100 100" class="logo-mark"><rect width="100" height="100" rx="22" fill="#FF4D00"/><rect x="20" y="40" width="60" height="22" rx="11" fill="#A0522D" stroke="#2A1503" stroke-width="6"/></svg>
    <span translate="no">PanFrikandel</span>
  </a>
  <span class="version admin-version"><%= version %></span>
  <% if (authed) { %>
  <form method="POST" action="/admin/logout" style="margin-left:auto">
    <button class="btn btn-add" type="submit">Uitloggen</button>
  </form>
  <% } %>
</header>

<div class="page" style="max-width:<%= authed ? '980px' : '420px' %>">
<% if (!authed) { %>
  <h1>Admin</h1>
  <% if (error) { %><p class="admin-error"><%= error %></p><% } %>
  <form method="POST" action="/admin/login" class="admin-login">
    <input type="password" name="password" placeholder="Wachtwoord" required autofocus>
    <button class="btn btn-primary" type="submit">Inloggen</button>
  </form>
<% } else { %>
  <% if (stats) { %>
  <h1>Bezorging <%= delivery.city %> +<%= delivery.radiusKm %> km</h1>
  <p style="color:var(--muted);font-weight:700">Laatste <%= stats.days %> dagen. Postcodechecks komen uit de winkelmand en de sectie „Dostawa”; bestellingen zijn betaalde Stripe-sessies. Checks buiten de zone laten zien waar vraag zit — handig om te beslissen of de straal (env <code>DELIVERY_RADIUS_KM</code>) omhoog kan.</p>
  <div class="stats">
    <div class="stat"><b><%= stats.checks %></b><span>postcodechecks</span></div>
    <div class="stat"><b><%= stats.inZone %></b><span>binnen de zone</span></div>
    <div class="stat"><b><%= stats.checks - stats.inZone %></b><span>buiten de zone</span></div>
    <div class="stat"><b><%= stats.uniqueCodes %></b><span>unieke postcodes</span></div>
    <div class="stat"><b><%= stats.orders %></b><span>bestellingen</span></div>
    <div class="stat"><b><%= zl(stats.revenueGr) %></b><span>omzet</span></div>
    <div class="stat"><b><%= quotes.length %></b><span>offerte-aanvragen (hurt)</span></div>
  </div>
  <% if (stats.outOfZone) { %><p class="admin-error">⚠️ <%= stats.outOfZone %> bestelling(en) met een afleveradres buiten de zone — controleer in Stripe.</p><% } %>

  <% if (stats.topCodes.length) { %>
  <h2 style="margin:18px 0 8px">Meest gecheckte postcodes</h2>
  <table class="admin-table">
    <thead><tr><th>Postcode</th><th>Plaats</th><th>Afstand</th><th>Zone</th><th style="text-align:right">Checks</th></tr></thead>
    <tbody>
    <% for (const c of stats.topCodes) { %>
      <tr>
        <td><b><%= c.code %></b></td>
        <td class="admin-unit"><%= c.place || 'onbekend — voeg toe aan ZONE_POSTCODES' %></td>
        <td class="admin-unit"><%= c.km != null ? c.km + ' km' : '–' %></td>
        <td><%= c.inZone ? '✅' : '—' %></td>
        <td style="text-align:right"><%= c.n %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <% } else { %>
  <p style="color:var(--muted);font-weight:700">Nog geen postcodechecks.</p>
  <% } %>

  <% if (stats.topOutside.length) { %>
  <h2 style="margin:18px 0 8px">Vraag buiten de zone</h2>
  <table class="admin-table">
    <thead><tr><th>Postcode</th><th>Plaats</th><th>Afstand</th><th style="text-align:right">Checks</th></tr></thead>
    <tbody>
    <% for (const c of stats.topOutside) { %>
      <tr>
        <td><b><%= c.code %></b></td>
        <td class="admin-unit"><%= c.place || 'onbekend' %></td>
        <td class="admin-unit"><%= c.km != null ? c.km + ' km' : '–' %></td>
        <td style="text-align:right"><%= c.n %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>

  <% if (stats.recentOrders.length) { %>
  <h2 style="margin:18px 0 8px">Laatste bestellingen</h2>
  <table class="admin-table">
    <thead><tr><th>Datum</th><th>Postcode</th><th>Plaats</th><th>Afstand</th><th style="text-align:right">Bedrag</th></tr></thead>
    <tbody>
    <% for (const o of stats.recentOrders) { %>
      <tr>
        <td class="admin-unit"><%= o.at.toLocaleDateString('nl-NL') %></td>
        <td><b><%= o.code || '?' %></b><% if (o.outOfZone) { %> ⚠️<% } %></td>
        <td class="admin-unit"><%= o.place || '–' %></td>
        <td class="admin-unit"><%= o.km != null ? o.km + ' km' : '–' %></td>
        <td style="text-align:right"><%= zl(o.amountGr || 0) %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>

  <% if (quotes.length) { %>
  <h2 style="margin:18px 0 8px">Offerte-aanvragen (hurt)</h2>
  <table class="admin-table">
    <thead><tr><th>Datum</th><th>Wie</th><th>Contact</th><th>Producten</th><th>Bericht</th></tr></thead>
    <tbody>
    <% for (const q of quotes) { %>
      <tr>
        <td class="admin-unit"><%= q.at.toLocaleDateString('nl-NL') %></td>
        <td><b><%= q.name %></b><% if (q.company) { %><br><small class="admin-unit"><%= q.company %></small><% } %><% if (q.place) { %><br><small class="admin-unit"><%= q.place %></small><% } %></td>
        <td class="admin-unit"><%= q.email %><% if (q.phone) { %><br><%= q.phone %><% } %></td>
        <td class="admin-unit"><% for (const it of (q.items || [])) { %><%= it.id %><%= it.qty ? ' × ' + it.qty : '' %><br><% } %></td>
        <td class="admin-unit"><%= q.message %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>
  <% } %>

  <h1 class="admin-section" id="live">Food truck — live GPS & abonnees</h1>
  <div class="admin-note">
    <% if (live.live) { %>🟢 <b>Live:</b> <%= live.place || (live.lat.toFixed(4) + ', ' + live.lon.toFixed(4)) %> · laatste signaal <%= live.ageMin %> min geleden (±<%= live.accuracy || '?' %> m)<% } else { %>⚪ Niet live<% if (truck.updatedAt) { %> — laatste signaal <%= new Date(truck.updatedAt).toLocaleString('nl-NL') %><% } %><% } %>.
    Laatste aankondiging: <%= truck.announcedAt ? new Date(truck.announcedAt).toLocaleString('nl-NL') + ' — ' + truck.place : 'nog niet' %>.<br>
    <% if (gpsToken) { %>Chauffeurspagina (telefoon in de kar, HTTPS): <a href="/kierowca?t=<%= encodeURIComponent(gpsToken) %>" target="_blank">/kierowca?t=…</a> — deze link bevat het token, deel hem alleen met wie in de kar staat. Trackers/apps kunnen posten naar <code>POST /api/gps</code> met header <code>x-gps-token</code>.<% } else { %>⚠️ <code>GPS_TOKEN</code> is niet gezet — de chauffeurspagina en <code>/api/gps</code> zijn uitgeschakeld.<% } %>
  </div>
  <form method="POST" action="/admin/oglos" class="admin-bar" style="position:static" onsubmit="return confirm('Locatie-mail sturen naar alle bevestigde abonnees?')">
    <input name="info" placeholder="Extra tekst in de mail (bv. „stoimy do 20:00”) — optioneel" maxlength="300">
    <button class="btn btn-primary" type="submit" <%= truck.lat == null ? 'disabled title="Nog geen GPS-positie"' : '' %>>📣 Locatie-mail sturen</button>
  </form>
  <% const subsActive = subs.filter(s => s.confirmed && !s.unsubscribedAt); %>
  <div class="stats">
    <div class="stat"><b><%= subsActive.length %></b><span>bevestigde abonnees</span></div>
    <div class="stat"><b><%= subs.filter(s => !s.confirmed).length %></b><span>nog niet bevestigd</span></div>
    <div class="stat"><b><%= subs.filter(s => s.unsubscribedAt).length %></b><span>afgemeld</span></div>
    <div class="stat"><b><%= subs.filter(s => s.codeUsedAt).length %></b><span>kortingscodes gebruikt</span></div>
    <div class="stat"><b><%= subDiscount.percent %>%</b><span>korting (<%= subDiscount.once ? 'eenmalig' : 'onbeperkt' %>)</span></div>
  </div>
  <% if (subs.length) { %>
  <table class="admin-table">
    <thead><tr><th>E-mail</th><th>Taal</th><th>Plaats</th><th>Status</th><th>Code</th><th>Aangemeld</th></tr></thead>
    <tbody>
    <% for (const s of subs.slice(0, 200)) { %>
      <tr class="<%= s.unsubscribedAt || !s.confirmed ? 'inactive' : '' %>">
        <td><b><%= s.email %></b></td>
        <td class="admin-unit"><%= s.lang %></td>
        <td class="admin-unit"><%= s.place || '–' %></td>
        <td class="admin-unit"><%= s.unsubscribedAt ? 'afgemeld' : (s.confirmed ? '✅ bevestigd' : '⏳ wacht op bevestiging') %></td>
        <td class="admin-unit"><%= s.code ? 'PF-' + s.code + (s.codeUsedAt ? ' · gebruikt' : '') : '–' %></td>
        <td class="admin-unit"><%= s.createdAt ? new Date(s.createdAt).toLocaleDateString('nl-NL') : '' %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <% } else { %>
  <p style="color:var(--muted);font-weight:700">Nog geen abonnees.</p>
  <% } %>

  <h1 class="admin-section" id="foodtruck">Food truck — standplaatsen</h1>
  <p style="color:var(--muted);font-weight:700">Waar en wanneer staat de frietkar? Dit vult de kaart en het schema op <a href="/foodtruck" target="_blank">/foodtruck</a>. Klik op de kaart om de plek te prikken (of vul lat/lon in). Standplaatsen in het verleden blijven bewaard maar verdwijnen van de site.</p>
  <div class="truck-admin">
    <form method="POST" action="/admin/foodtruck" class="truck-form">
      <input name="name" class="wide" placeholder="Naam van de plek (bv. Stary Rynek, Płock)" required maxlength="120">
      <input name="address" class="wide" placeholder="Adres (optioneel)" maxlength="200">
      <label>Van <input type="date" name="dateFrom" required></label>
      <label>Tot <input type="date" name="dateTo"></label>
      <input name="hours" placeholder="Uren (bv. 12:00–20:00)" maxlength="60">
      <input name="note" placeholder="Notitie (bv. festyn parafialny)" maxlength="300">
      <input name="lat" id="stopLat" placeholder="lat (klik op de kaart)" inputmode="decimal">
      <input name="lon" id="stopLon" placeholder="lon" inputmode="decimal">
      <button class="btn btn-primary" type="submit">Standplaats toevoegen</button>
    </form>
    <div id="adminMap" class="truck-map truck-map-admin"></div>
  </div>
  <% if (stops.length) { const today = new Date().toISOString().slice(0, 10); %>
  <table class="admin-table">
    <thead><tr><th>Van – tot</th><th>Plek</th><th>Uren</th><th>Notitie</th><th>Kaart</th><th></th></tr></thead>
    <tbody>
    <% for (const s of stops) { %>
      <tr class="<%= s.dateTo < today ? 'past' : '' %>">
        <td class="admin-unit"><%= s.dateFrom %><% if (s.dateTo !== s.dateFrom) { %> – <%= s.dateTo %><% } %></td>
        <td><b><%= s.name %></b><% if (s.address) { %><br><small class="admin-unit"><%= s.address %></small><% } %></td>
        <td class="admin-unit"><%= s.hours || '–' %></td>
        <td class="admin-unit"><%= s.note || '' %></td>
        <td class="admin-unit"><%= s.lat != null ? '📍' : '—' %></td>
        <td><form method="POST" action="/admin/foodtruck/usun" onsubmit="return confirm('Standplaats verwijderen?')"><input type="hidden" name="id" value="<%= s.id %>"><button class="btn btn-danger" type="submit">✕</button></form></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <% } else { %>
  <p style="color:var(--muted);font-weight:700">Nog geen standplaatsen — de site toont nu „Pierwsze lokalizacje ogłosimy wkrótce”.</p>
  <% } %>

  <% if (events.length) { %>
  <h2 style="margin:18px 0 8px">Evenement-aanvragen (food truck)</h2>
  <table class="admin-table">
    <thead><tr><th>Ontvangen</th><th>Wie</th><th>Evenement</th><th>Datum · plek · gasten</th><th>Bericht</th></tr></thead>
    <tbody>
    <% for (const e of events) { %>
      <tr>
        <td class="admin-unit"><%= e.at.toLocaleDateString('nl-NL') %></td>
        <td><b><%= e.name %></b><br><small class="admin-unit"><%= e.email %><% if (e.phone) { %> · <%= e.phone %><% } %></small></td>
        <td class="admin-unit"><%= e.event || '–' %></td>
        <td class="admin-unit"><%= e.date %><br><%= e.place %><% if (e.guests) { %><br>~<%= e.guests %> gasten<% } %></td>
        <td class="admin-unit"><%= e.message %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  <% } %>

  <h1 class="admin-section">Producten & prijzen</h1>
  <div class="admin-note">
    Prijs = inkoop (Vomar, €) × koers <b><%= pricing.eurPln %></b> × opslag <b>×<%= pricing.markup %></b>, afgerond op ,90 zł
    (env <code>PRICING_EUR_PLN</code> / <code>PRICING_MARKUP</code>). Een handmatige prijs overschrijft de berekende; leeg = terug naar berekend kan niet, vul dan de berekende waarde in.
    „Actief” bepaalt of het product in de shop staat — zo schaal je op zonder code.
  </div>

  <div class="admin-bar">
    <input type="search" id="adminFilter" placeholder="Zoek product… (bijv. frikandel, oven, wege)">
    <button class="btn btn-primary" id="adminSave" disabled>Opslaan</button>
  </div>
  <p id="adminStatus" class="admin-status" hidden></p>

  <table class="admin-table" id="adminTable">
    <thead><tr><th>Actief</th><th>Product</th><th>Eenheid</th><th style="text-align:right">Inkoop €</th><th style="text-align:right">Berekend zł</th><th style="text-align:right">Prijs (zł)</th><th style="text-align:right">Marge</th></tr></thead>
    <tbody>
      <% for (const p of products) { const on = p.active !== false; const costGr = p.buyEur ? Math.round(p.buyEur * pricing.eurPln * 100) : 0; const margin = costGr ? Math.round((p.price - costGr) / p.price * 100) : null; %>
      <tr data-search="<%= (p.name + ' ' + p.cat + ' ' + (p.badge || '')).toLowerCase() %>" class="<%= on ? '' : 'inactive' %>">
        <td><input type="checkbox" class="admin-active" data-id="<%= p.id %>" <%= on ? 'checked' : '' %> data-orig="<%= on ? '1' : '0' %>"></td>
        <td><b><%= p.name %></b><% if (p.badge) { %> <small class="admin-badge"><%= p.badge %></small><% } %><br><small class="admin-unit"><%= p.cat %><% if (p.mora) { %> · <a href="<%= p.mora %>" target="_blank" rel="noopener">mora.nl</a><% } %></small></td>
        <td class="admin-unit"><%= p.unit %></td>
        <td class="admin-num"><%= p.buyEur ? '€ ' + p.buyEur.toFixed(2) : '–' %></td>
        <td class="admin-num"><%= p.basePrice ? zl(p.basePrice) : '–' %></td>
        <td style="text-align:right">
          <input type="number" step="0.01" min="1" class="admin-price" data-id="<%= p.id %>"
                 value="<%= (p.price / 100).toFixed(2) %>" data-orig="<%= (p.price / 100).toFixed(2) %>">
        </td>
        <td class="admin-num"><%= margin != null ? margin + '%' : '–' %></td>
      </tr>
      <% } %>
    </tbody>
  </table>

<script>
(function () {
  const $ = s => document.querySelector(s);
  const saveBtn = $('#adminSave'), status = $('#adminStatus');

  function changedPrices() {
    return [...document.querySelectorAll('.admin-price')].filter(i => parseFloat(i.value) !== parseFloat(i.dataset.orig));
  }
  function changedFlags() {
    return [...document.querySelectorAll('.admin-active')].filter(c => (c.checked ? '1' : '0') !== c.dataset.orig);
  }
  function refresh() {
    document.querySelectorAll('#adminTable tbody tr').forEach(tr => {
      const price = tr.querySelector('.admin-price'), flag = tr.querySelector('.admin-active');
      const dirty = parseFloat(price.value) !== parseFloat(price.dataset.orig) || (flag.checked ? '1' : '0') !== flag.dataset.orig;
      tr.classList.toggle('dirty', dirty);
      tr.classList.toggle('inactive', !flag.checked);
    });
    saveBtn.disabled = changedPrices().length + changedFlags().length === 0;
  }
  document.addEventListener('input', e => { if (e.target.matches('.admin-price, .admin-active')) refresh(); });

  $('#adminFilter').addEventListener('input', e => {
    const q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('#adminTable tbody tr').forEach(tr => {
      tr.hidden = q && !tr.dataset.search.includes(q);
    });
  });

  saveBtn.addEventListener('click', async () => {
    const dirtyP = changedPrices(), dirtyF = changedFlags();
    if (!dirtyP.length && !dirtyF.length) return;
    const prices = {}, active = {};
    for (const i of dirtyP) prices[i.dataset.id] = i.value;
    for (const c of dirtyF) active[c.dataset.id] = c.checked;
    saveBtn.disabled = true;
    saveBtn.textContent = 'Opslaan…';
    try {
      const r = await fetch('/admin/prices', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prices, active })
      });
      const data = await r.json();
      if (r.ok) {
        for (const i of dirtyP) i.dataset.orig = parseFloat(i.value).toFixed(2);
        for (const c of dirtyF) c.dataset.orig = c.checked ? '1' : '0';
        refresh();
        status.textContent = '✅ ' + data.saved + ' wijziging(en) opgeslagen en direct live.';
      } else {
        status.textContent = '⚠️ ' + (data.error || 'Opslaan mislukt.');
        saveBtn.disabled = false;
      }
    } catch (e) {
      status.textContent = '⚠️ Verbindingsfout — probeer opnieuw.';
      saveBtn.disabled = false;
    }
    status.hidden = false;
    saveBtn.textContent = 'Opslaan';
  });
})();
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
(function () {
  // Admin-kaart: klik prikt de standplaats (lat/lon in het formulier); bestaande standplaatsen als pins
  const el = document.getElementById('adminMap');
  if (!el || !window.L) return;
  const stops = <%- JSON.stringify(stops.filter(s => s.lat != null).map(s => ({ name: s.name, lat: s.lat, lon: s.lon, dateFrom: s.dateFrom, dateTo: s.dateTo }))) %>;
  const map = L.map(el).setView([52.5464, 19.7065], 11);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '&copy; OpenStreetMap' }).addTo(map);
  const icon = L.divIcon({ className: 'pf-pin', html: '🍟', iconSize: [36, 36], iconAnchor: [18, 34], popupAnchor: [0, -30] });
  for (const s of stops) L.marker([s.lat, s.lon], { icon }).addTo(map).bindPopup('<b>' + s.name.replace(/</g, '&lt;') + '</b><br>' + s.dateFrom + (s.dateTo !== s.dateFrom ? ' – ' + s.dateTo : ''));
  let pin = null;
  map.on('click', e => {
    document.getElementById('stopLat').value = e.latlng.lat.toFixed(5);
    document.getElementById('stopLon').value = e.latlng.lng.toFixed(5);
    if (pin) pin.setLatLng(e.latlng); else pin = L.marker(e.latlng, { icon }).addTo(map);
  });
})();
</script>
<% } %>
</div>
</body>
</html>
