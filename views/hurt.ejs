<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= t('hurtTitle') %></title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= t('hurtMetaDesc') %>">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23FF4D00'/><rect x='22' y='40' width='56' height='20' rx='10' fill='%23A0522D' stroke='%232A1503' stroke-width='5'/></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,700;0,800;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css?v=<%= v %>">
</head>
<body>
<%- include('partials/snacks') %>

<header class="nav">
  <a href="/" class="logo">
    <svg viewBox="0 0 100 100" class="logo-mark"><rect width="100" height="100" rx="22" fill="#FF4D00"/><rect x="20" y="40" width="60" height="22" rx="11" fill="#A0522D" stroke="#2A1503" stroke-width="6"/><path d="M28 50 Q50 44 72 50" stroke="#7B3A16" stroke-width="4" fill="none"/></svg>
    <span translate="no">PanFrikandel</span>
  </a>
  <nav class="nav-links">
    <a href="/#sklep"><%= t('navShop') %></a>
    <a href="/#dostawa"><%= t('navDelivery') %></a>
    <a href="/hurt" class="on"><%= t('navHurt') %></a>
    <a href="/#faq"><%= t('navFaq') %></a>
  </nav>
  <%- include('partials/lang') %>
  <button class="cart-btn" id="askBtn" aria-label="<%= t('hurtDrawerTitle') %>">
    <span>📦 <%= t('hurtBtn') %></span>
    <b id="askCount" class="cart-count" hidden>0</b>
  </button>
</header>

<!-- ======================= HERO (hurt) ======================= -->
<section class="hero hero-hurt">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-kicker"><%= t('hurtKicker') %></p>
      <h1><%- t('hurtH1Html') %></h1>
      <p class="hero-sub"><%= t('hurtIntro') %></p>
      <div class="hero-cta">
        <a href="#katalog" class="btn btn-primary"><%= t('navHurt') %> ↓</a>
        <a href="/" class="btn btn-ghost"><%= t('hurtBackShop') %></a>
      </div>
    </div>
    <div class="hero-art">
      <div class="hero-sticker">40<br>szt.</div>
      <svg viewBox="0 0 140 140" class="hero-snack"><use href="#snack-box"/></svg>
      <svg viewBox="0 0 140 140" class="hero-snack hero-snack-2"><use href="#snack-saus"/></svg>
    </div>
  </div>
  <div class="check-strip"></div>
</section>

<!-- ======================= STAPPEN ======================= -->
<section class="delivery">
  <div class="delivery-inner">
    <div class="steps steps-3">
      <% dict.hurtSteps.forEach((s, i) => { %>
      <div class="step"><b><%= i + 1 %></b><h4><%= s.t %></h4><p><%= s.p %></p></div>
      <% }) %>
    </div>
  </div>
  <div class="check-strip"></div>
</section>

<!-- ======================= KATALOG ======================= -->
<main id="katalog" class="shop">
  <div class="section-head">
    <h2><%- t('hurtH1Html') %></h2>
    <p><%- t('hurtNoteHtml') %></p>
  </div>

  <% for (const catId of Object.keys(dict.catsHurt)) { %>
    <% const inCat = products.filter(x => x.cat === catId); if (!inCat.length) continue; %>
    <h3 class="cat-title"><%= dict.catsHurt[catId] %></h3>
    <div class="grid">
      <% for (const p of inCat) { %>
        <%- include('partials/card-hurt', { p }) %>
      <% } %>
    </div>
  <% } %>

  <!-- Detail-content per product (verborgen; modal kopieert dit) -->
  <% for (const p of products.filter(x => x.details)) { const d = p.details; %>
    <div class="pd" id="pd-<%= p.id %>" hidden>
      <div class="pd-media">
        <% if (p.img) { %><img src="/img/<%= p.img %>" alt="<%= p.name %>"><% } %>
        <% if (p.img2) { %><img src="/img/<%= p.img2 %>" alt="<%= p.name %>"><% } %>
        <% if (!p.img) { %><svg viewBox="0 0 140 140"><use href="#snack-<%= p.icon %>"/></svg><% } %>
      </div>
      <h3><%= p.name %></h3>
      <p class="pd-unit"><%= p.unit %> · <span class="pd-price"><%= t('hurtNoPrice') %></span></p>
      <p><%= p.desc %></p>
      <% if (d.prep) { %>
        <h4><%= t('pdPrep') %></h4>
        <table class="pd-table"><% for (const [k, v2] of d.prep) { %><tr><th><%= k %></th><td><%= v2 %></td></tr><% } %></table>
      <% } %>
      <% if (d.specs) { %>
        <h4><%= t('pdSpecs') %></h4>
        <table class="pd-table"><% for (const [k, v2] of d.specs) { %><tr><th><%= k %></th><td><%= v2 %></td></tr><% } %></table>
      <% } %>
      <% if (d.ingredients) { %>
        <h4><%= t('pdIngredients') %></h4>
        <p class="pd-small"><%= d.ingredients %></p>
      <% } %>
      <% if (d.allergens) { %>
        <h4><%= t('pdAllergens') %></h4>
        <p class="pd-small"><strong><%= d.allergens %></strong></p>
      <% } %>
      <% if (d.nutrition) { %>
        <h4><%= t('pdNutrition') %></h4>
        <table class="pd-table pd-table-nutri"><% for (const [k, v2] of d.nutrition) { %><tr><th><%= k %></th><td><%= v2 %></td></tr><% } %></table>
      <% } %>
      <% if (d.storage) { %>
        <h4><%= t('pdStorage') %></h4>
        <p class="pd-small"><%= d.storage %></p>
      <% } %>
      <button class="btn btn-primary" data-ask="<%= p.id %>" data-name="<%= p.name %>" style="width:100%;margin-top:18px"><%= t('hurtAsk') %></button>
    </div>
  <% } %>
</main>

<!-- ======================= FOOTER ======================= -->
<footer class="footer">
  <div class="footer-inner">
    <div>
      <p class="footer-logo">PanFrikandel</p>
      <p><%- t('footerTaglineHtml') %></p>
    </div>
    <div>
      <p class="footer-head"><%= t('footerShop') %></p>
      <a href="/#sklep"><%= t('footerAll') %></a>
      <a href="/hurt"><%= t('footerHurt') %></a>
      <a href="/#dostawa"><%= t('navDelivery') %></a>
    </div>
    <div>
      <p class="footer-head"><%= t('footerInfo') %></p>
      <a href="/regulamin"><%= t('footerTerms') %></a>
      <a href="/prywatnosc"><%= t('footerPrivacy') %></a>
      <a href="mailto:hallo@panfrikandel.pl">hallo@panfrikandel.pl</a>
    </div>
  </div>
  <p class="footer-note">© <%= new Date().getFullYear() %> PanFrikandel · <%= t('footerNote') %></p>
</footer>

<!-- ======================= ZAPYTANIE (drawer) ======================= -->
<div class="cart-overlay" id="askOverlay" hidden></div>
<aside class="cart" id="askDrawer" aria-label="<%= t('hurtDrawerTitle') %>" hidden>
  <div class="cart-head">
    <h3><%= t('hurtDrawerTitle') %></h3>
    <button class="cart-close" id="askClose" aria-label="<%= t('close') %>">✕</button>
  </div>
  <div class="cart-items" id="askItems"></div>
  <form class="cart-foot ask-form" id="askForm">
    <div class="ask-grid">
      <input name="name" placeholder="<%= t('hurtFormName') %>" maxlength="120" autocomplete="name" required>
      <input name="company" placeholder="<%= t('hurtFormCompany') %>" maxlength="120" autocomplete="organization">
      <input name="email" type="email" placeholder="<%= t('hurtFormEmail') %>" maxlength="160" autocomplete="email">
      <input name="phone" type="tel" placeholder="<%= t('hurtFormPhone') %>" maxlength="40" autocomplete="tel">
      <input name="place" placeholder="<%= t('hurtFormPlace') %>" maxlength="120" class="ask-wide">
      <textarea name="message" placeholder="<%= t('hurtFormMessage') %>" maxlength="2000" rows="3" class="ask-wide"></textarea>
    </div>
    <p class="zone-result" id="askStatus" hidden></p>
    <button type="submit" class="btn btn-primary btn-checkout" id="askSend"><%= t('hurtSend') %></button>
  </form>
</aside>

<!-- ======================= PRODUCT MODAL ======================= -->
<div class="modal-overlay" id="pdOverlay" hidden>
  <div class="modal" role="dialog" aria-modal="true">
    <button class="modal-close" id="pdClose" aria-label="<%= t('close') %>">✕</button>
    <div class="modal-body" id="pdBody"></div>
  </div>
</div>

<script>
  window.LANG = <%- JSON.stringify(lang) %>;
  window.T = <%- JSON.stringify(dict.client) %>;
  window.CATALOG = <%- JSON.stringify(products.map(p => ({ id: p.id, name: p.name, unit: p.unit, icon: p.icon, img: p.img || null }))) %>;
</script>
<script src="/hurt.js?v=<%= v %>"></script>
</body>
</html>
