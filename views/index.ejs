<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= t('title') %></title>
  <%- include('partials/head') %>
</head>
<body>
<%- include('partials/snacks') %>
<%
  // Variabelen voor de teksten: {radius} {city} {price} {free} {eta}
  const D = delivery;
  const V = { radius: D.radiusKm, city: D.city, price: zl(D.priceGr), free: zl(D.freeAboveGr), eta: D.eta };
  const fill = (s, vars) => Object.entries(vars).reduce((acc, [k, val]) => acc.split('{' + k + '}').join(val), s);
%>

<!-- ======================= TOPBAR ======================= -->
<div class="topbar">
  <div class="marquee"><div class="marquee-track">
    <% for (let i = 0; i < 3; i++) { for (const w of dict.marquee) { %><span><%= fill(w, V) %></span><i>★</i><% } } %>
  </div></div>
</div>

<header class="nav">
  <a href="/" class="logo">
    <svg viewBox="0 0 100 100" class="logo-mark"><rect width="100" height="100" rx="22" fill="#FF4D00"/><rect x="20" y="40" width="60" height="22" rx="11" fill="#A0522D" stroke="#2A1503" stroke-width="6"/><path d="M28 50 Q50 44 72 50" stroke="#7B3A16" stroke-width="4" fill="none"/></svg>
    <span translate="no">PanFrikandel</span>
  </a>
  <nav class="nav-links">
    <a href="#sklep"><%= t('navShop') %></a>
    <a href="#dostawa"><%= t('navDelivery') %></a>
    <a href="/hurt"><%= t('navHurt') %></a>
    <a href="/foodtruck"><%= t('navTruck') %></a>
    <a href="#faq"><%= t('navFaq') %></a>
  </nav>
  <%- include('partials/lang') %>
  <button class="cart-btn" id="cartBtn" aria-label="<%= t('navCart') %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><circle cx="9" cy="21" r="1.6"/><circle cx="19" cy="21" r="1.6"/><path d="M2 3h3l2.6 12.4a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.6L22 7H6"/></svg>
    <span><%= t('navCart') %></span>
    <b id="cartCount" class="cart-count" hidden>0</b>
  </button>
</header>

<!-- ======================= HERO ======================= -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-kicker"><%= t('heroKicker') %></p>
      <h1><%- t('heroH1Html') %></h1>
      <p class="hero-sub"><%- t('heroSubHtml', V) %></p>
      <div class="hero-cta">
        <a href="#sklep" class="btn btn-primary"><%= t('heroCta') %></a>
        <a href="#dostawa" class="btn btn-ghost"><%= t('heroCta2') %></a>
      </div>
      <div class="hero-badges">
        <span><%= t('badgeFrozen') %></span>
        <span><%= t('badgePay') %></span>
        <span><%= t('badgeDelivery', V) %></span>
        <span><%= t('badgeZone', V) %></span>
      </div>
    </div>
    <div class="hero-art">
      <div class="hero-sticker"><%- t('stickerHtml') %></div>
      <svg viewBox="0 0 140 140" class="hero-snack"><use href="#snack-frikandel"/></svg>
      <svg viewBox="0 0 140 140" class="hero-snack hero-snack-2"><use href="#snack-bitterbal"/></svg>
    </div>
  </div>
  <div class="check-strip"></div>
</section>

<!-- ======================= SKLEP ======================= -->
<main id="sklep" class="shop">
  <div class="section-head">
    <h2><%- t('shopH2Html') %></h2>
    <p><%= t('shopSub') %></p>
  </div>

  <% for (const catId of Object.keys(dict.cats)) { %>
    <% const inCat = products.filter(x => x.cat === catId); if (!inCat.length) continue;
       const tops = inCat.filter(p => p.top).length ? inCat.filter(p => p.top) : inCat.slice(0, 4);
       const rest = inCat.filter(p => !tops.includes(p)); %>
    <h3 class="cat-title"><%= dict.cats[catId] %></h3>
    <div class="grid">
      <% for (const p of tops) { %>
        <%- include('partials/card', { p }) %>
      <% } %>
    </div>
    <% if (rest.length) { %>
      <div class="grid grid-more" id="more-<%= catId %>" hidden>
        <% for (const p of rest) { %>
          <%- include('partials/card', { p }) %>
        <% } %>
      </div>
      <div class="more-wrap">
        <button class="btn btn-more" data-more="<%= catId %>" data-count="<%= inCat.length %>"><%- t('showAllHtml', { n: inCat.length }) %></button>
      </div>
    <% } %>
  <% } %>

  <!-- Detail-content per product (verborgen; modal kopieert dit) -->
  <% for (const p of products.filter(x => x.details)) { const d = p.details; %>
    <div class="pd" id="pd-<%= p.id %>" hidden>
      <div class="pd-media">
        <% if (p.img) { %><img src="/img/<%= p.img %>" alt="<%= p.name %>"><% } %>
        <% if (p.img2) { %><img src="/img/<%= p.img2 %>" alt="<%= p.name %>"><% } %>
        <% if (!p.img) { %><svg viewBox="0 0 140 140"><use href="#snack-<%= p.icon %>"/></svg><% } %>
      </div>
      <h3><%= p.name %></h3>
      <p class="pd-unit"><%= p.unit %> · <span class="pd-price"><%= zl(p.price) %></span></p>
      <p><%= p.desc %></p>
      <% if (d.prep) { %>
        <h4><%= t('pdPrep') %></h4>
        <table class="pd-table"><% for (const [k, v2] of d.prep) { %><tr><th><%= k %></th><td><%= v2 %></td></tr><% } %></table>
      <% } %>
      <% if (d.specs) { %>
        <h4><%= t('pdSpecs') %></h4>
        <table class="pd-table"><% for (const [k, v2] of d.specs) { %><tr><th><%= k %></th><td><%= v2 %></td></tr><% } %></table>
      <% } %>
      <% if (d.ingredients) { %>
        <h4><%= t('pdIngredients') %></h4>
        <p class="pd-small"><%= d.ingredients %></p>
      <% } %>
      <% if (d.allergens) { %>
        <h4><%= t('pdAllergens') %></h4>
        <p class="pd-small"><strong><%= d.allergens %></strong></p>
      <% } %>
      <% if (d.nutrition) { %>
        <h4><%= t('pdNutrition') %></h4>
        <table class="pd-table pd-table-nutri"><% for (const [k, v2] of d.nutrition) { %><tr><th><%= k %></th><td><%= v2 %></td></tr><% } %></table>
      <% } %>
      <% if (d.storage) { %>
        <h4><%= t('pdStorage') %></h4>
        <p class="pd-small"><%= d.storage %></p>
      <% } %>
      <button class="btn btn-primary" data-add="<%= p.id %>" style="width:100%;margin-top:18px"><%= t('addToCart') %> · <%= zl(p.price) %></button>
    </div>
  <% } %>

  <!-- Większe ilości → /hurt (cena na zapytanie) · Food truck → /foodtruck -->
  <div class="banners">
    <a class="hurt-banner" href="/hurt">
      <div>
        <p class="local-kicker"><%= t('hurtBannerKicker') %></p>
        <h3><%- t('hurtBannerH3Html') %></h3>
        <p><%= t('hurtBannerP') %></p>
      </div>
      <span class="btn btn-primary"><%= t('hurtBannerCta') %></span>
    </a>
    <a class="hurt-banner truck-banner" href="/foodtruck">
      <div>
        <p class="local-kicker"><%= t('truckBannerKicker') %></p>
        <h3><%- t('truckBannerH3Html') %></h3>
        <p><%= t('truckBannerP') %></p>
      </div>
      <span class="btn btn-primary"><%= t('truckBannerCta') %></span>
    </a>
  </div>
</main>

<!-- ======================= DOSTAWA ======================= -->
<section id="dostawa" class="delivery">
  <div class="check-strip"></div>
  <div class="delivery-inner">
    <h2><%- t('deliveryH2Html') %></h2>
    <div class="steps">
      <% dict.steps.forEach((s, i) => { %>
      <div class="step"><b><%= i + 1 %></b><h4><%= fill(s.t, V) %></h4><p><%- fill(s.p, V) %></p></div>
      <% }) %>
    </div>

    <!-- Strefa dostawy: postcodecheck -->
    <div class="local-box" id="strefa">
      <div class="local-copy">
        <p class="local-kicker"><%= t('zoneKicker', V) %></p>
        <h3><%- t('zoneH3Html') %></h3>
        <p><%- t('zonePHtml', V) %></p>
      </div>
      <form class="zone-form" data-zone-form data-source="sekcja">
        <label for="zoneKod"><%= t('zoneLabel') %></label>
        <div class="zone-row">
          <input id="zoneKod" data-zone-input inputmode="numeric" autocomplete="postal-code" placeholder="<%= t('zonePlaceholder') %>" maxlength="6" aria-label="<%= t('zoneAria') %>">
          <button class="btn btn-primary" type="submit"><%= t('zoneCheck') %></button>
        </div>
        <p class="zone-result" data-zone-result hidden></p>
      </form>
    </div>
  </div>
  <div class="check-strip"></div>
</section>

<!-- ======================= FAQ ======================= -->
<section id="faq" class="faq">
  <div class="section-head"><h2><%- t('faqH2Html') %></h2></div>
  <% for (const f of dict.faq) { %>
  <details><summary><%= fill(f.q, V) %></summary><p><%= fill(f.a, V) %></p></details>
  <% } %>
</section>

<!-- ======================= FOOTER ======================= -->
<footer class="footer">
  <div class="footer-inner">
    <div>
      <p class="footer-logo">PanFrikandel</p>
      <p><%- t('footerTaglineHtml') %></p>
      <p class="footer-head" style="margin-top:14px"><%= t('footerFollow') %></p>
      <%- include('partials/socials') %>
    </div>
    <div>
      <p class="footer-head"><%= t('footerShop') %></p>
      <a href="#sklep"><%= t('footerAll') %></a>
      <a href="/hurt"><%= t('footerHurt') %></a>
      <a href="/foodtruck"><%= t('footerTruck') %></a>
      <a href="#dostawa"><%= t('navDelivery') %></a>
      <a href="#faq"><%= t('navFaq') %></a>
    </div>
    <div>
      <p class="footer-head"><%= t('footerInfo') %></p>
      <a href="/regulamin"><%= t('footerTerms') %></a>
      <a href="/prywatnosc"><%= t('footerPrivacy') %></a>
      <a href="mailto:hallo@panfrikandel.pl">hallo@panfrikandel.pl</a>
    </div>
  </div>
  <div class="footer-pay" aria-label="<%= t('footerPayAria') %>">
    <span class="footer-pay-label"><%= t('footerPayLabel') %></span>
    <span class="pay-chip pay-blik" title="BLIK">blik</span>
    <span class="pay-chip pay-p24" title="Przelewy24">Przelewy<b>24</b></span>
    <span class="pay-chip pay-visa" title="Visa">VISA</span>
    <span class="pay-chip pay-mc" title="Mastercard">
      <svg viewBox="0 0 38 24" width="34" height="21" role="img" aria-label="Mastercard" focusable="false">
        <circle cx="13" cy="12" r="9" fill="#EB001B"/>
        <circle cx="25" cy="12" r="9" fill="#F79E1B"/>
        <path d="M19 5.29A9 9 0 0 1 19 18.71A9 9 0 0 1 19 5.29Z" fill="#FF5F00"/>
      </svg>
    </span>
  </div>
  <p class="footer-note">© <%= new Date().getFullYear() %> PanFrikandel · <%= t('footerNote') %><br><small><%= company.name %><% if (company.nip) { %> · NIP <%= company.nip %><% } %><% if (company.address) { %> · <%= company.address %><% } %> · <span class="version"><%= version %></span></small></p>
</footer>

<!-- ======================= CART DRAWER ======================= -->
<div class="cart-overlay" id="cartOverlay" hidden></div>
<aside class="cart" id="cartDrawer" aria-label="<%= t('navCart') %>" hidden>
  <div class="cart-head">
    <h3><%= t('cartTitle') %></h3>
    <button class="cart-close" id="cartClose" aria-label="<%= t('close') %>">✕</button>
  </div>
  <div class="cart-items" id="cartItems"></div>
  <div class="cart-foot">
    <form class="cart-zone" data-zone-form data-source="koszyk">
      <span class="cart-zone-label"><%= t('cartZoneLabel', V) %></span>
      <input data-zone-input inputmode="numeric" autocomplete="postal-code" placeholder="<%= t('cartZonePlaceholder') %>" maxlength="6" aria-label="<%= t('zoneAria') %>">
      <button type="submit" class="btn btn-add"><%= t('zoneCheck') %></button>
      <p class="zone-result" data-zone-result hidden></p>
    </form>
    <form class="cart-zone cart-code" data-code-form>
      <span class="cart-zone-label"><%= t('cartCodeLabel') %></span>
      <input data-code-input placeholder="<%= t('cartCodePlaceholder') %>" maxlength="12" autocomplete="off" autocapitalize="characters" aria-label="<%= t('cartCodeLabel') %>">
      <button type="submit" class="btn btn-add"><%= t('cartCodeApply') %></button>
      <p class="zone-result" data-code-result hidden></p>
    </form>
    <p class="cart-ship" id="cartShip"></p>
    <p class="cart-discount" id="cartDiscount" hidden></p>
    <div class="cart-total"><span><%= t('cartTotal') %></span><b id="cartTotal">0,00 zł</b></div>
    <button class="btn btn-primary btn-checkout" id="checkoutBtn" disabled><%= t('checkout') %></button>
    <p class="cart-pay"><%= t('cartPay') %></p>
  </div>
</aside>

<!-- ======================= AI ASSISTENT ======================= -->
<button class="ai-fab" id="aiFab" aria-label="<%= t('aiFab') %>">
  <svg viewBox="0 0 100 100" width="30" height="30"><rect x="14" y="38" width="72" height="24" rx="12" fill="#A0522D" stroke="#2A1503" stroke-width="7"/><path d="M24 48 Q50 41 76 48" stroke="#7B3A16" stroke-width="5" fill="none"/></svg>
  <span><%= t('aiFab') %></span>
</button>
<aside class="ai-panel" id="aiPanel" hidden aria-label="<%= t('aiName') %>">
  <div class="ai-head">
    <div>
      <b><%= t('aiName') %></b>
      <small><%= t('aiSub') %></small>
    </div>
    <button class="cart-close" id="aiClose" aria-label="<%= t('close') %>">✕</button>
  </div>
  <div class="ai-msgs" id="aiMsgs">
    <div class="ai-msg ai-msg-bot"><%= t('aiWelcome') %></div>
  </div>
  <form class="ai-form" id="aiForm">
    <input type="text" id="aiInput" placeholder="<%= t('aiPlaceholder') %>" maxlength="500" autocomplete="off">
    <button type="submit" class="btn btn-primary ai-send" id="aiSend">➤</button>
  </form>
</aside>

<!-- ======================= PRODUCT MODAL ======================= -->
<div class="modal-overlay" id="pdOverlay" hidden>
  <div class="modal" role="dialog" aria-modal="true">
    <button class="modal-close" id="pdClose" aria-label="<%= t('close') %>">✕</button>
    <div class="modal-body" id="pdBody"></div>
  </div>
</div>

<script>
  window.LANG = <%- JSON.stringify(lang) %>;
  window.T = <%- JSON.stringify(dict.client) %>;
  window.DELIVERY = <%- JSON.stringify(delivery) %>;
  window.CATALOG = <%- JSON.stringify(products.map(p => ({ id: p.id, name: p.name, price: p.price, unit: p.unit, icon: p.icon, img: p.img || null }))) %>;
</script>
<script src="/shop.js?v=<%= v %>"></script>
</body>
</html>
