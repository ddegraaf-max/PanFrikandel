<article class="card">
  <% if (p.badge) { %><span class="badge"><%= p.badge %></span><% } %>
  <div class="card-art" data-details="<%= p.id %>" role="button" tabindex="0" aria-label="Szczegóły produktu">
    <% if (p.img) { %>
      <img src="/img/<%= p.img %>" alt="<%= p.name %>" loading="lazy">
    <% } else { %>
      <svg viewBox="0 0 140 140"><use href="#snack-<%= p.icon %>"/></svg>
    <% } %>
  </div>
  <h4><%= p.name %></h4>
  <p class="card-unit"><%= p.unit %></p>
  <p class="card-desc"><%= p.desc %></p>
  <% if (p.details) { %><button class="card-more" data-details="<%= p.id %>">Składniki i przygotowanie →</button><% } %>
  <div class="card-foot">
    <span class="price"><%= zl(p.price) %></span>
    <button class="btn btn-add" data-add="<%= p.id %>">+ Do koszyka</button>
  </div>
</article>
