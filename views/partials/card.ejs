<% const stock = p.stock == null ? null : p.stock; %>
<article class="card">
  <% if (p.badge) { %><span class="badge"><%= p.badge %></span><% } %>
  <div class="card-art" data-details="<%= p.id %>" role="button" tabindex="0" aria-label="<%= t('productDetails') %>">
    <% if (p.img) { %>
      <img src="/img/<%= p.img %>" alt="<%= p.name %>" loading="lazy">
    <% } else { %>
      <svg viewBox="0 0 140 140"><use href="#snack-<%= p.icon %>"/></svg>
    <% } %>
  </div>
  <h4><%= p.name %></h4>
  <p class="card-unit"><%= p.unit %></p>
  <p class="card-desc"><%= p.desc %></p>
  <% if (p.details) { %><button class="card-more" data-details="<%= p.id %>"><%= p.details.specs ? t('cardSpecs') : t('cardIngredients') %> →</button><% } %>
  <% if (stock !== null) { %>
    <p class="stock <%= stock <= 0 ? 'stock-out' : (stock <= 3 ? 'stock-low' : '') %>"><%= stock <= 0 ? t('stockOut', { eta: delivery.backorderEta }) : (stock <= 3 ? t('stockLow', { n: stock }) : t('stockIn', { n: stock })) %></p>
  <% } %>
  <div class="card-foot">
    <span class="price"><%= zl(p.price) %></span>
    <button class="btn btn-add" data-add="<%= p.id %>"><%= t('addToCart') %></button>
  </div>
</article>
